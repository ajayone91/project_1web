<% layout("/layouts/boilerplates") %> 

<div class="row">
    <div class="col-8 offset-2">
    <h3> new listing here</h3>
    
    <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" name="listing[title]" placeholder="title" class="form-control" required> 
            <div class="valid-feedback">
                Looks good!
              </div>
        </div>


        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <input type="text" name="listing[description]" placeholder="description" class="form-control" required>
            <div class="invalid-feedback">
                Please enter a valid description.
            </div>
        </div>

        <div class="mb-3">
            <label for="category" class="form-label">Category</label>
            <select id="category" name="listing[category]" class="form-select" required>
                <option value="" selected disabled>Choose a category</option>
                <% listingCategories.forEach(({ name }) => { %>
                    <option value="<%= name %>"><%= name %></option>
                <% }) %>
            </select>
            <div class="invalid-feedback">Please choose a category.</div>
        </div>


        <div class="mb-3">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" placeholder="location" class="form-control" required>
            required
            <div class="invalid-feedback">
                Please enter a valid location.
            </div>
        </div>




        <div class="mb-3">
            <label for="image" class="form-label">Upload listing image</label>
            <input type="file" name="listing[image]" class="form-control" >
        </div>

        <!-- <div class="mb-3">
            <label for="imageUrl" class="form-label">Image Url</label>
            <input type="text" name="listing[imageUrl]" placeholder="imageUrl" class="form-control" >
            <div class="invalid-feedback">
                Please enter an valid image url.
            </div>
        </div> -->



    <div class="row" >
        <div class="mb-3 col-md-4">
            <label for="country" class="form-label">Country</label>
            <input type="text" name="listing[country]" placeholder="country" class="form-control" required>
            <div class="invalid-feedback">
                Please enter a valid country.
            </div>
        </div>

        <div class="mb-3 col-md-8">
            <label for="price" class="form-label">Price</label>
            <input type="text" name="listing[price]" placeholder="price" class="form-control" required>
            <div class="invalid-feedback">
                Please enter a valid price.
            </div>
        </div>
    </div>
       

        <br><br><br>

        <button class="btn btn-dark">add</button>
    </form>
    <br> <br> <br> <br>
    </div>
</div>

    
