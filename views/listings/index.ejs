

<% layout("/layouts/boilerplates") %> <%=massage%>

<style>
#filters {
   display: flex;
   flex-wrap: wrap;
   gap: 1.5rem;
}

.filter{
   text-align: center;
   margin-top: 2rem;
   opacity: 0.7;
   color: inherit;
   text-decoration: none;
}
.filter:hover{
   opacity: 1;
}

.filter.active{
   opacity: 1;
   border-bottom: 2px solid #222;
}

.filter p{
   font-size: 0.7rem;
}
</style>

<div id="filters">
   <a class="filter <%= selectedCategory ? '' : 'active' %>" href="/listings<%= search ? `?search=${encodeURIComponent(search)}` : '' %>">
      <div><i class="fa-solid fa-layer-group"></i></div>
      <p>All</p>
   </a>
   <% listingCategories.forEach(({ name, icon }) => { %>
      <% const params = new URLSearchParams(); params.set("category", name); if (search) params.set("search", search); %>
      <a class="filter <%= selectedCategory === name ? 'active' : '' %>" href="/listings?<%= params.toString() %>">
         <div><i class="fa-solid <%= icon %>"></i></div>
         <p><%= name %></p>
      </a>
   <% }) %>

   <div class="text-toggle">
      <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
      </div>

   </div>

</div>


 <div class="row  row-cols-lg-4 row-cols-md-2 row-cols-sm-2 mt-3">

    <% for (listing of allListing) { %>
<a href="/listings/<%= listing._id %>" class="text-link">
   <div class="card col listing-card " >
   <img src="<%= listing.image.url %>" 
   class="card-img-top" alt="listing image url" 
   style="height: 13rem; object-fit: cover;"
   />
   
   <div class="card-img-overlay"></div>
   <div class="card-body">
     <p class="card-text"><b> <%= listing.title %></b><br>
     <%= listing.price != null ? `₹ ${listing.price.toLocaleString("en-IN")} /night` : "Price not set" %>

   </div>
</div>
</a>
   
      <% } %>
 </div>


 <script>
   let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click", ()=>{
   console.log("clicked");
  })
     
 </script>